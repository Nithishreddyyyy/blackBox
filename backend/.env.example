# BlackBox — Environment Configuration
# Copy this file to .env and fill in all required (*) values before running.
#
#   cp .env.example .env
#
# NEVER commit your .env file. It is listed in .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# * REQUIRED — change user/password/host/dbname to match your MySQL instance.
DATABASE_URL=mysql+asyncmy://blackbox_user:CHANGEME@localhost:3306/blackbox

# ─── JWT Security ────────────────────────────────────────────────────────────
# * REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX_STRING

# Token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS Allowed Origins ────────────────────────────────────────────────────
# Comma-separated list of frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Challenge Configuration ─────────────────────────────────────────────────
# * REQUIRED — the secret string participants must elicit from the LLM.
TARGET_OUTPUT=REPLACE_WITH_YOUR_SECRET

# Optional: Override the default system prompt.
# Leave blank to auto-generate from TARGET_OUTPUT.
# LLM_SYSTEM_PROMPT=

# ─── Admin Seed User ─────────────────────────────────────────────────────────
# * REQUIRED — the admin account created on first run.
ADMIN_EMAIL=admin@blackbox.io
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=Platform Admin

# ─── LLM Provider ────────────────────────────────────────────────────────────
# One of: ollama | openai | openrouter
LLM_PROVIDER=ollama

# Ollama (local — default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (set LLM_PROVIDER=openrouter to use)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct
